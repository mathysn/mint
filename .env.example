# Local development: copy to .env (never commit .env). The server uses .env.production.example.

# Postgres. Neon's Vercel integration injects both; locally `pnpm db:local` prints the URL to use.
DATABASE_URL=postgres://mint:mint@localhost:54329/mint
DATABASE_URL_UNPOOLED=postgres://mint:mint@localhost:54329/mint

# Discord application (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Public copy of the client id, read by the Discord activity SDK in the browser
VITE_DISCORD_CLIENT_ID=
# Contact shown on /privacy and /terms (optional)
VITE_CONTACT_EMAIL=

# Base URL of the app, no trailing slash (OAuth redirect = APP_BASE_URL/api/auth/discord/callback)
APP_BASE_URL=http://localhost:5173

# Random strings (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
CRON_SECRET=
IP_HASH_SALT=
