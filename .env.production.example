# Mint on the server: copy to /opt/mint/.env (deploy/setup.sh does it and fills the secrets).
# Never commit the real file. docker-compose.yml reads it.

# ── Domain ──────────────────────────────────────────────────────────────────
# The domain players open, without https:// (its DNS A record points at this server).
MINT_DOMAIN=csmint.app
# Same, as a URL without trailing slash (Discord redirect = APP_BASE_URL/api/auth/discord/callback).
APP_BASE_URL=https://csmint.app

# ── HTTPS ───────────────────────────────────────────────────────────────────
# "caddy" when ports 80/443 are free on this server (Caddy gets the certificate).
# Empty when another web server (nginx…) already uses them: point it at 127.0.0.1:APP_PORT.
COMPOSE_PROFILES=caddy
APP_PORT=3080

# ── Discord application ─────────────────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Shown on the privacy and terms pages for data requests (optional).
CONTACT_EMAIL=

# ── Secrets (setup.sh generates them: `openssl rand -hex 32`) ────────────────
POSTGRES_PASSWORD=
CRON_SECRET=
IP_HASH_SALT=

# ── Memory caps, so Mint never takes the Discord bots' memory ───────────────
PG_MEM_LIMIT=640m
APP_MEM_LIMIT=512m

# ── Offsite backups on Cloudflare R2 (optional, deploy/backup.sh) ───────────
# R2 → Manage API tokens → "Object Read & Write" on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mint-backups
# Days of dumps kept, on the server and in R2.
BACKUP_KEEP_DAYS=14
