{
  "name": "mint",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch server/dev.ts",
    "dev:web": "vite",
    "db:local": "tsx scripts/local-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "catalog:import": "tsx scripts/import-catalog.ts",
    "check:ledger": "tsx scripts/check-ledger.ts",
    "staff:set": "tsx scripts/staff.ts set",
    "staff:remove": "tsx scripts/staff.ts remove",
    "staff:list": "tsx scripts/staff.ts list",
    "build": "vite build",
    "vercel-build": "tsx scripts/migrate.ts && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "2.5.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@hono/node-server": "2.1.5",
    "@tanstack/react-query": "5.104.5",
    "@vercel/functions": "3.10.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv": "18.0.8",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
